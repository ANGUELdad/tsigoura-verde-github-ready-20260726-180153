# Tsigoura Verde Resort - Vercel environment variables
# Copy these names into Vercel Project Settings -> Environment Variables.
# Do not commit real secrets here.

# Live menu database (Vercel KV)
# DO NOT set these by hand — Vercel adds them when you create a KV store in
# the Storage tab. Listed here only so you know what to expect.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Menu image uploads (Vercel Blob)
# DO NOT set this by hand when the Blob store is attached through Vercel.
# BLOB_READ_WRITE_TOKEN=

# Private admin login
ADMIN_PIN=change-this-long-pin
ADMIN_PASSWORD=
TSIGOURA_ADMIN_PIN=

# Public venue/contact settings served by /api/public-config
PUBLIC_VENUE_NAME=Tsigoura Verde Resort
PUBLIC_VENUE_SUBTITLE=
PUBLIC_CONTACT_EMAIL=reservations@tsigouraverderesort.gr
PUBLIC_PHONE=
PUBLIC_INSTAGRAM=https://www.instagram.com/tsigoura?igsh=MWdmcXlhMjU0YW42Zw==
PUBLIC_FACEBOOK=https://www.facebook.com/share/1GjmnuzxQ1/?mibextid=wwXIfr
PUBLIC_MAPS_URL=https://share.google/OxdtzMmM5ONBN1hm8
PUBLIC_WEBSITE_URL=

# Public Wi-Fi QR settings
PUBLIC_WIFI_SSID=TSIGOURA 5G
PUBLIC_WIFI_PASS=Tsigoura2023
PUBLIC_WIFI_ENC=WPA

# Public menu mode switches — FALLBACK DEFAULTS ONLY.
# Once you publish menu-live.js from /admin, that file decides the mode for
# every device and these are ignored. Set PUBLIC_TRADITIONAL_MENU_ONLY=false if
# you want the cart enabled before publishing for the first time.
# Admin/table QR links add ?mode=order&order=1 when online ordering is enabled.
PUBLIC_SERVICE_OPEN=true
PUBLIC_ACCEPT_ORDERS=true
PUBLIC_TRADITIONAL_MENU_ONLY=true

# Public legal/business details
PUBLIC_COMPANY_NAME=
PUBLIC_AFM=
PUBLIC_DOY=
PUBLIC_GEMI=
PUBLIC_ADDRESS=
PUBLIC_MHTE=
PUBLIC_AGORANOMIKOS=
