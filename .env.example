# Tsigoura Verde Resort - Vercel environment variables
# Copy these names into Vercel Project Settings -> Environment Variables.
# Do not commit real secrets here.

# ---------------------------------------------------------------------------
# Admin auth (required for live edits / uploads / history)
# ---------------------------------------------------------------------------
# IMPORTANT: Do NOT start ADMIN_PIN with "@" in the Vercel UI — Vercel treats
# "@name" as a Shared Environment Variable reference and the PIN will be empty.
# If your PIN must begin with @, prefix it with "pin:" in ANY of these vars:
#   ADMIN_PIN=pin:@your-pin
#   ADMIN_PIN_LITERAL=pin:@your-pin
ADMIN_PIN=change-this-long-pin
ADMIN_PASSWORD=
TSIGOURA_ADMIN_PIN=
# ADMIN_PIN_LITERAL=
# Optional HMAC secret for the HttpOnly admin session cookie (defaults to ADMIN_PIN)
# ADMIN_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Live menu database (Vercel KV / Upstash Redis REST)
# DO NOT set these by hand — Vercel adds them when you create a KV store in
# the Storage tab. Listed here only so you know what to expect.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# Also accepted if you attach Upstash directly:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# Menu image uploads (Vercel Blob)
# DO NOT set these by hand when the Blob store is attached through Vercel.
# New stores use short-lived OIDC authentication and inject BLOB_STORE_ID.
# Older stores may inject BLOB_READ_WRITE_TOKEN; both are supported.
# BLOB_STORE_ID=
# BLOB_READ_WRITE_TOKEN=

# ---------------------------------------------------------------------------
# Booking emails (POST /api/book via Resend). Optional — guest falls back to mailto.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
BOOKING_TO_EMAIL=reservations@tsigouraverderesort.gr
BOOKING_EMAIL=reservations@tsigouraverderesort.gr
BOOKING_FROM_EMAIL=Tsigoura Verde Resort <bookings@yourdomain.gr>
RESEND_FROM_EMAIL=Tsigoura Verde Resort <bookings@yourdomain.gr>
BOOKING_REPLY_TO=

# Public venue/contact settings served by GET /api/public-config.
# These are FALLBACK DEFAULTS. Admin → Settings can override them live
# (stored under tsigoura:public-config:v1). Stored overrides win over env.
PUBLIC_VENUE_NAME=Tsigoura Verde Resort
PUBLIC_VENUE_SUBTITLE=
PUBLIC_CONTACT_EMAIL=reservations@tsigouraverderesort.gr
# Alias accepted by /api/public-config when PUBLIC_CONTACT_EMAIL is empty:
# PUBLIC_BOOKING_EMAIL=reservations@tsigouraverderesort.gr
PUBLIC_PHONE=
PUBLIC_INSTAGRAM=https://www.instagram.com/tsigoura?igsh=MWdmcXlhMjU0YW42Zw==
PUBLIC_FACEBOOK=https://www.facebook.com/share/1GjmnuzxQ1/?mibextid=wwXIfr
PUBLIC_MAPS_URL=https://share.google/OxdtzMmM5ONBN1hm8
PUBLIC_WEBSITE_URL=

# Public Wi-Fi QR settings
PUBLIC_WIFI_SSID=TSIGOURA 5G
PUBLIC_WIFI_PASS=Tsigoura2023
PUBLIC_WIFI_ENC=WPA

# Public menu mode switches — FALLBACK DEFAULTS ONLY.
# Once you publish menu-live.js from /admin, that file decides the mode for
# every device and these are ignored. Set PUBLIC_TRADITIONAL_MENU_ONLY=false if
# you want the cart enabled before publishing for the first time.
# Admin/table QR links add ?mode=order&order=1 when online ordering is enabled.
PUBLIC_SERVICE_OPEN=true
PUBLIC_ACCEPT_ORDERS=true
PUBLIC_TRADITIONAL_MENU_ONLY=true

# Public legal/business details (editable in Admin → Settings)
PUBLIC_COMPANY_NAME=
PUBLIC_AFM=
PUBLIC_DOY=
PUBLIC_GEMI=
PUBLIC_ADDRESS=
PUBLIC_MHTE=
PUBLIC_AGORANOMIKOS=
